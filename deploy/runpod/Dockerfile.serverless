# RunPod serverless worker image: NInfer built for sm_90a (H100) with a Python
# handler that keeps one ninfer-serve process resident per worker.
#
# Build from the repository root and push:
#   docker build -f deploy/runpod/Dockerfile.serverless \
#       --tag <registry>/ninfer-h100-serverless:latest .
#   docker push <registry>/ninfer-h100-serverless:latest

FROM nvidia/cuda:13.1.2-devel-ubuntu24.04 AS build

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        cmake \
        libavcodec-dev \
        libavformat-dev \
        libavutil-dev \
        libcurl4-openssl-dev \
        libswscale-dev \
        ninja-build \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# This lane is H100-only; the engine build is pinned to sm_90a.
RUN cmake -S . -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=90a \
        -DNINFER_BUILD_APPS=ON \
        -DBUILD_TESTING=OFF \
        -DNINFER_BUILD_BENCHMARKS=OFF \
    && cmake --build /build --parallel --target ninfer-serve

FROM nvidia/cuda:13.1.2-runtime-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
# cuda-compat carries forward-compatibility libcuda for datacenter GPUs (H100):
# it lets this CUDA 13.1 engine run on hosts whose driver predates the r580
# branch that CUDA 13.1 normally requires. RunPod fleet drivers roll out
# unevenly and cannot be pinned per endpoint.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        cuda-compat-13-1 \
        libavcodec60 \
        libavformat60 \
        libavutil58 \
        libcurl4t64 \
        libswscale7 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --no-cache-dir runpod==1.12.0

ENV LD_LIBRARY_PATH=/usr/local/cuda/compat:${LD_LIBRARY_PATH:-}

COPY --from=build /build/apps/ninfer-serve /usr/local/bin/ninfer-serve
COPY deploy/runpod/worker.py /app/worker.py
COPY tools/bench/serve_metrics.py /app/serve_metrics.py

# Model artifacts are served from a network volume mounted at /models.
ENV NINFER_MODEL=/models/qwen3_8_27b.ninfer

WORKDIR /app
CMD ["python3", "-u", "worker.py"]
